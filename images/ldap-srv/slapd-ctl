#!/bin/bash
# slapd-ctl start|stop|restart|status  (el equivalente a systemctl en este contenedor)
case "$1" in
  stop)    touch /run/slapd.parado; pkill -x slapd; for i in $(seq 20); do pidof slapd >/dev/null || break; sleep 0.3; done; echo "slapd parado";;
  start)   rm -f /run/slapd.parado; for i in $(seq 30); do pidof slapd >/dev/null && break; sleep 0.3; done; pidof slapd >/dev/null && echo "slapd en marcha" || { echo "slapd no arranca"; exit 1; };;
  restart) "$0" stop; "$0" start;;
  status)  pidof slapd >/dev/null && echo "slapd activo (PID $(pidof slapd))" || { echo "slapd parado"; exit 3; };;
  *) echo "uso: slapd-ctl start|stop|restart|status"; exit 2;;
esac
