#!/bin/bash
# Levanta sssd y sshd (lo que haría entrada.sh) y espera a que el cliente resuelva usuarios del directorio.
# Es idempotente. Requiere que ldap-srv ya esté arrancado.
pgrep -f '[e]ntrada.sh' >/dev/null || setsid nohup /usr/local/bin/entrada.sh >/var/log/entrada.log 2>&1 </dev/null &
for i in $(seq 1 120); do
  getent passwd ana >/dev/null 2>&1 && exit 0
  sleep 0.5
done
echo "el cliente aún no resuelve a ana" >&2; exit 1
